+    // draw anything at all, and it failed with zero visible signal).
+    try { injectControls(); } catch(e) { console.error('[KCM Timeline] injectControls failed:', e); _tlShowError('controls: ' + e.message); }
+    try { tlRenderStatic(); } catch(e) { console.error('[KCM Timeline] tlRenderStatic failed:', e); _tlShowError('render: ' + e.message); }
+  };
+
+  // ── Live-sync fix (v2) ───────────────────────────────────────────────
+  // The first attempt wrapped window.updateStaffNotation, assuming the
+  // app's internal code called it through the window object. It doesn't —
+  // every internal caller invokes the closure-local function directly, so
+  // reassigning window.updateStaffNotation from outside was never actually
+  // reached. That's not fixable by wrapping; the real fix is to stop trying
+  // to intercept a call we can't see, and instead watch the state itself.
+  //
+  // rootNote / currentLevel / currentTriadSelection / currentExtendedSelection /
+  // selectedNotes are all real getters on window (confirmed reachable — see
+  // the Object.defineProperties block near the top of the file). Polling
+  // them is closure-independent: it doesn't matter whether the change came
+  // from a level button, the dock, a keyboard shortcut, or a direct click
+  // on the guitar/piano/circle — if the state changed, this sees it.
+  let _tlLastSnapshot = null;
+  function _tlSnapshotState() {
+    try {
+      const sel = Array.from(window.selectedNotes || []).sort((a,b)=>a-b);
+      return JSON.stringify([
+        window.rootNote, window.currentLevel,
+        window.currentTriadSelection, window.currentExtendedSelection,
+        window.currentModeSelection, window.currentScaleType,
+        window.currentHarmDegree, window.currentHarmChordType, sel
+      ]);
+    } catch(e) { return null; }
+  }
+  setInterval(() => {
+    try {
+      const svg = document.getElementById('timelineSVG');
+      if (!svg || svg.style.display === 'none') return; // only redraw while the tab is actually visible
+      const snap = _tlSnapshotState();
+      if (snap !== null && snap !== _tlLastSnapshot) {
+        _tlLastSnapshot = snap;
+        tlRenderStatic();
+      }
+    } catch(e) { console.error('[KCM Timeline] poll loop failed:', e); }
+  }, 200);
+})();
+
+// ═══════════════════════════════════════════════════════════════════════
+// KCM PROGRESSION TIMELINE — additive only, separate small module.
+// Adds a horizontal chord track under the existing Chord Progressions
+// panel (Harmonized Major/Minor). The progression buttons and "Play All
+// Scale Chords" call the app's real playProgression()/playAllScaleChords()
+// directly as closure-local calls — same reason wrapping window.X doesn't
+// intercept them (see the Timeline module's notes above). Instead of
+// intercepting, this listens for the same clicks via event delegation
+// (an ADDITIONAL listener alongside the existing onclick handlers — both
+// fire, neither is replaced) and independently drives a purely visual
+// horizontal track using the exact same timing formula playProgression()
+// itself uses (chordDur = 60000 / currentBPM). It touches no audio and no
+// sphere/highlight state — those already work correctly today.
+(function(){
+  'use strict';
+  const PROG_LABELS_MAJOR = ['I','ii','iii','IV','V','vi','vii°'];
+  const PROG_LABELS_MINOR = ['i','ii°','III','iv','v','VI','VII'];
+  // Mirrors updateProgressionButtons()'s hardcoded lists exactly, in the
+  // same fixed render order, so a click's DOM index maps to the right degrees.
+  const PROGRESSIONS_MAJOR = [
+    {degrees:[0,3,4,0]}, {degrees:[0,4,5,3]}, {degrees:[0,5,3,4]},
+    {degrees:[1,4,0]},   {degrees:[5,3,0,4]}, {degrees:[0,3,5,4]}
+  ];
+  const PROGRESSIONS_MINOR = [
+    {degrees:[0,3,4]},   {degrees:[0,5,6]},   {degrees:[0,3,6]},
+    {degrees:[0,2,5,6]}, {degrees:[0,5,2,6]}, {degrees:[0,4,5,3]}
+  ];
+
+  let progRAF = null;
+
+  function buildProgTrack(degrees) {
+    const wrap = document.getElementById('progTimeline');
+    const track = document.getElementById('progTimelineTrack');
+    if (!wrap || !track) return;
+    const isMajor = window.currentLevel === 'harmMajor';
+    const labels = isMajor ? PROG_LABELS_MAJOR : PROG_LABELS_MINOR;
+    track.innerHTML = '';
+    degrees.forEach((deg, i) => {
+      const box = document.createElement('div');
+      box.dataset.idx = i;
+      box.textContent = labels[deg] || '?';
+      box.style.cssText = "flex:1;max-width:80px;padding:10px 4px;text-align:center;font-family:'Cinzel',serif;font-weight:800;font-size:0.85rem;border-radius:8px;border:2px solid rgba(0,128,128,0.35);background:rgba(0,128,128,0.08);color:#ccc;transition:all 0.15s;";
+      track.appendChild(box);
+    });
+    wrap.style.display = '';
+  }
+
+  function highlightProgBox(idx) {
+    document.querySelectorAll('#progTimelineTrack > div').forEach(box => {
+      const active = parseInt(box.dataset.idx, 10) === idx;
+      box.style.background = active ? 'linear-gradient(135deg,#008080,#006666)' : 'rgba(0,128,128,0.08)';
+      box.style.color = active ? '#fff' : '#ccc';
+      box.style.borderColor = active ? '#00b3b3' : 'rgba(0,128,128,0.35)';
+      box.style.transform = active ? 'translateY(-3px) scale(1.06)' : '';
+    });
+  }
+
+  function runProgTimeline(degrees) {
+    try {
+      if (progRAF) cancelAnimationFrame(progRAF);
+      buildProgTrack(degrees);
+      const bpm = window.currentBPM || 100;
+      const chordDur = 60000 / bpm; // ms — matches playProgression()'s own timing exactly
+      const totalMs = degrees.length * chordDur;
+      const startMs = performance.now();
+      const statusEl = document.getElementById('progTimelineStatus');
+      function animate() {
+        const elapsed = performance.now() - startMs;
+        if (elapsed >= totalMs) {
+          highlightProgBox(-1);
+          if (statusEl) statusEl.textContent = '';
+          progRAF = null;
+          return;
+        }
+        const idx = Math.floor(elapsed / chordDur);
+        highlightProgBox(idx);
+        if (statusEl) statusEl.textContent = `Chord ${idx + 1} of ${degrees.length}`;
+        progRAF = requestAnimationFrame(animate);
+      }
+      progRAF = requestAnimationFrame(animate);
+    } catch(e) { console.error('[KCM Progression Timeline] failed:', e); }
+  }
+
+  function initProgButtonListener() {
+    const container = document.getElementById('progressionButtons');
+    if (container && !container.dataset.tlHooked) {
+      container.dataset.tlHooked = '1';
+      container.addEventListener('click', (e) => {
+        const btn = e.target.closest('.level-btn');
+        if (!btn || !container.contains(btn)) return;
+        const idx = Array.from(container.children).indexOf(btn);
+        const isMajor = window.currentLevel === 'harmMajor';
+        const list = isMajor ? PROGRESSIONS_MAJOR : PROGRESSIONS_MINOR;
+        const prog = list[idx];
+        if (prog) runProgTimeline(prog.degrees);
+      });
+    }
+    const allBtn = document.getElementById('playAllChordsBtn');
+    if (allBtn && !allBtn.dataset.tlHooked) {
+      allBtn.dataset.tlHooked = '1';
+      allBtn.addEventListener('click', () => runProgTimeline([0,1,2,3,4,5,6]));
+    }
+  }
+  initProgButtonListener();
+})();
+
+// ═══════════════════════════════════════════════════════════════════════
+// KCM RECORDING TIMELINE — additive only, separate small module.
+// The Recording Studio's "Playback" button already calls the real
+// playbackRecording() (closure-local, unreachable by wrapping window.X for
+// the same reason documented above), so this attaches an ADDITIONAL click
+// listener on the same #playRecBtn — both fire, neither is replaced — and
+// independently renders a left-to-right mini-staff of the actual recorded
+// notes (window.recordedNotes, newly exposed via getter above), each note
+// positioned by its real timestamp rather than a fixed beat grid, since a
+// user recording has no fixed tempo. No audio or highlight logic here —
+// playbackRecording() already handles real sound correctly on its own.
+(function(){
+  'use strict';
+  const diatonicStep = {0:0,1:0,2:1,3:1,4:2,5:3,6:3,7:4,8:4,9:5,10:5,11:6};
+  const KEY_SIGNATURES = {
+    0:{sharps:0,flats:0}, 1:{sharps:0,flats:5}, 2:{sharps:2,flats:0}, 3:{sharps:0,flats:3},
+    4:{sharps:4,flats:0}, 5:{sharps:0,flats:1}, 6:{sharps:6,flats:0}, 7:{sharps:1,flats:0},
+    8:{sharps:0,flats:4}, 9:{sharps:3,flats:0}, 10:{sharps:0,flats:2}, 11:{sharps:5,flats:0}
+  };
+  // Same sharps/flats-per-key data and staff-line Y positions the real
+  // STAFF tab's own drawStaff() uses (keySignatures / sharpPos / flatPos),
+  // just scaled down for this smaller mini-staff. Drawn right after the
+  // clef, same as every real staff notation convention.
+  function drawKeySig(svg, rootPc) {
+    const sig = KEY_SIGNATURES[rootPc] || KEY_SIGNATURES[0];
+    let x = 26;
+    if (sig.sharps > 0) {
+      const sharpPos = [20,35,15,50,25,60,40];
+      for (let i = 0; i < sig.sharps; i++) {
+        const s = document.createElementNS('http://www.w3.org/2000/svg','text');
+        s.setAttribute('x', x); s.setAttribute('y', sharpPos[i]); s.setAttribute('font-size','16');
+        s.setAttribute('font-weight','bold'); s.setAttribute('font-family','serif');
+        s.textContent = '♯'; s.setAttribute('fill','#000'); svg.appendChild(s);
+        x += 7;
+      }
+    } else if (sig.flats > 0) {
+      const flatPos = [40,55,45,50,30,35,25];
+      for (let i = 0; i < sig.flats; i++) {
+        const f = document.createElementNS('http://www.w3.org/2000/svg','text');
+        f.setAttribute('x', x); f.setAttribute('y', flatPos[i]); f.setAttribute('font-size','16');
+        f.setAttribute('font-weight','bold'); f.setAttribute('font-family','serif');
+        f.textContent = '♭'; f.setAttribute('fill','#000'); svg.appendChild(f);
+        x += 7;
+      }
+    }
+    return x;
+  }
+  function noteY(pc, oct) {
+    const steps = diatonicStep[pc] + (oct - 4) * 7;
+    return 70 - steps * 5;
+  }
+  let recRAF = null;
+
+  function drawRecStaff(notes, totalMs, revealUpToMs) {
+    const svg = document.getElementById('recTimelineSVG');
+    if (!svg) return;
+    svg.innerHTML = '';
+    const sig = KEY_SIGNATURES[window.rootNote || 0] || KEY_SIGNATURES[0];
+    const marginX = 34 + Math.max(sig.sharps, sig.flats) * 7;
+    const W = 320, H = 100, trackW = W - marginX - 10;
+    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
+    for (let i = 0; i < 5; i++) {
+      const line = document.createElementNS('http://www.w3.org/2000/svg','line');
+      line.setAttribute('x1', marginX - 4); line.setAttribute('y1', 20 + i * 10);
+      line.setAttribute('x2', W - 6);       line.setAttribute('y2', 20 + i * 10);
+      line.setAttribute('stroke', '#000');  line.setAttribute('stroke-width', '1');
+      svg.appendChild(line);
+    }
+    const clef = document.createElementNS('http://www.w3.org/2000/svg','text');
+    clef.setAttribute('x', '2'); clef.setAttribute('y', '48'); clef.setAttribute('font-size', '30');
+    clef.setAttribute('font-family', 'serif'); clef.textContent = '𝄞'; clef.setAttribute('fill', '#000');
+    svg.appendChild(clef);
+    drawKeySig(svg, window.rootNote || 0);
+    const visible = (typeof revealUpToMs === 'number')
+      ? notes.filter(n => n.timestamp <= revealUpToMs + 1)
+      : notes;
+    visible.forEach(n => {
+      const x = marginX + (totalMs > 0 ? (n.timestamp / totalMs) * trackW : 0);
+      const y = noteY(n.note, n.octave);
+      if (y >= 70) for (let ly = 70; ly <= y; ly += 10) {
+        const led = document.createElementNS('http://www.w3.org/2000/svg','line');
+        led.setAttribute('x1', x-5); led.setAttribute('y1', ly); led.setAttribute('x2', x+5); led.setAttribute('y2', ly);
+        led.setAttribute('stroke', '#000'); led.setAttribute('stroke-width', '1'); svg.appendChild(led);
+      }
+      if (y <= 10) for (let ly = 10; ly >= y; ly -= 10) {
+        const led = document.createElementNS('http://www.w3.org/2000/svg','line');
+        led.setAttribute('x1', x-5); led.setAttribute('y1', ly); led.setAttribute('x2', x+5); led.setAttribute('y2', ly);
+        led.setAttribute('stroke', '#000'); led.setAttribute('stroke-width', '1'); svg.appendChild(led);
+      }
+      const nh = document.createElementNS('http://www.w3.org/2000/svg','ellipse');
+      nh.setAttribute('cx', x); nh.setAttribute('cy', y); nh.setAttribute('rx', '4'); nh.setAttribute('ry', '3.4');
+      nh.setAttribute('fill', '#008080'); nh.setAttribute('stroke', '#000'); nh.setAttribute('stroke-width', '0.8');
+      svg.appendChild(nh);
+    });
+    if (typeof revealUpToMs === 'number' && totalMs > 0) {
+      const px = marginX + Math.min(revealUpToMs / totalMs, 1) * trackW;
+      const ph = document.createElementNS('http://www.w3.org/2000/svg','line');
+      ph.setAttribute('x1', px); ph.setAttribute('y1', '12'); ph.setAttribute('x2', px); ph.setAttribute('y2', '70');
+      ph.setAttribute('stroke', '#e74c3c'); ph.setAttribute('stroke-width', '1.5'); ph.setAttribute('opacity', '0.85');
+      svg.appendChild(ph);
+    }
+  }
+
+  function runRecTimeline() {
+    try {
+      const notes = Array.from(window.recordedNotes || []);
+      const svg = document.getElementById('recTimelineSVG');
+      if (!svg || notes.length === 0) return;
+      if (recRAF) cancelAnimationFrame(recRAF);
+      svg.style.display = '';
+      const last = notes[notes.length - 1];
+      const totalMs = last.timestamp + (last.duration * 1000 || 400);
+      const startMs = performance.now();
+      function animate() {
+        const elapsed = performance.now() - startMs;
+        if (elapsed >= totalMs) {
+          drawRecStaff(notes, totalMs, totalMs);
+          recRAF = null;
+          return;
+        }
+        drawRecStaff(notes, totalMs, elapsed);
+        recRAF = requestAnimationFrame(animate);
+      }
+      recRAF = requestAnimationFrame(animate);
+    } catch(e) { console.error('[KCM Recording Timeline] failed:', e); }
+  }
+
+  function initRecButtonListener() {
+    const btn = document.getElementById('playRecBtn');
+    if (btn && !btn.dataset.tlHooked) {
+      btn.dataset.tlHooked = '1';
+      btn.addEventListener('click', runRecTimeline);
+    }
+  }
+  initRecButtonListener();
+})();
+
+</script>
 </body>
 </html>
